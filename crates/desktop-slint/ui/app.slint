import { LoginPanel } from "login_panel.slint";
import { MainShell } from "main_shell.slint";
import {
    GroupRow,
    SignerRow,
    MemberRow,
    FormingMemberRow,
    RequestRow,
} from "types.slint";

export {
    GroupRow,
    SignerRow,
    MemberRow,
    FormingMemberRow,
    RequestRow,
} from "types.slint";

export component AppWindow inherits Window {
    preferred-width: 1000px;
    preferred-height: 720px;
    title: "Подпись MPC (Slint)";

    in-out property <string> server-url;
    in-out property <bool> unlocked: false;
    in-out property <string> role-label;
    in-out property <bool> connected;
    in-out property <string> status-text;
    in-out property <bool> status-is-error;
    in-out property <bool> busy;

    in-out property <string> login-username;
    in-out property <string> login-password;

    in-out property <bool> is-admin;
    in-out property <string> group-name-input;
    in-out property <string> threshold-input: "2";
    in-out property <[GroupRow]> groups;
    in-out property <[SignerRow]> signer-pick;
    in-out property <[MemberRow]> member-remove-pick;
    in-out property <[MemberRow]> member-add-pick;
    in-out property <string> group-detail-title;
    in-out property <string> group-detail-body;
    in-out property <bool> show-start-dkg;
    in-out property <bool> start-dkg-enabled;
    in-out property <bool> show-forming-panel;
    in-out property <string> forming-panel-hint;
    in-out property <[FormingMemberRow]> forming-members;
    in-out property <string> solana-recipient;
    in-out property <string> solana-lamports;
    in-out property <bool> show-membership-editor;
    in-out property <bool> show-solana-actions;
    in-out property <string> group-ceremony-banner;
    in-out property <[RequestRow]> requests;
    in-out property <int> inbox-tab-index;
    in-out property <string> inbox-tab-title: "Сообщения";
    in-out property <bool> show-group-sign-panel;
    in-out property <string> group-sign-title;
    in-out property <string> group-sign-body;
    in-out property <string> group-sign-status;
    in-out property <string> group-sign-hint;
    in-out property <string> group-sign-request-id;
    in-out property <bool> group-sign-can-approve;
    in-out property <string> group-signer-hint;

    in-out property <bool> show-create-wizard;
    in-out property <int> create-wizard-step;
    in-out property <string> create-wizard-error;
    in-out property <string> create-wizard-summary;
    in-out property <string> signer-search;

    in-out property <bool> show-accept-participation;

    callback login-clicked();
    callback login-submit(string, string);
    callback logout-clicked();
    callback refresh-clicked();
    callback create-group-clicked();
    callback create-wizard-cancel();
    callback create-wizard-back();
    callback create-wizard-next();
    callback create-wizard-create();
    callback signer-search-changed(string);
    callback toggle-signer(string);
    callback select-group(string);
    callback start-dkg-clicked();
    callback reshare-clicked();
    callback request-solana-clicked();
    callback approve-request(string);
    callback reject-request(string);
    callback toggle-remove-member(string);
    callback toggle-add-member(string);
    callback accept-participation-clicked();

    init => { keyboard-root.focus(); }

    keyboard-root := FocusScope {
        width: 100%;
        height: 100%;

        KeyBinding {
            keys: @keys(Control + W);
            activated => { root.close(); }
        }

        if !root.unlocked: LoginPanel {
            width: 100%;
            height: 100%;
            server-url: root.server-url;
            login-username <=> root.login-username;
            login-password <=> root.login-password;
            busy: root.busy;
            status-text: root.status-text;
            status-is-error: root.status-is-error;
            login-submit(username, password) => { root.login-submit(username, password); }
        }

        if root.unlocked: MainShell {
            width: 100%;
            height: 100%;
            role-label: root.role-label;
            server-url: root.server-url;
            connected: root.connected;
            busy: root.busy;
            is-admin: root.is-admin;
            status-text: root.status-text;
            status-is-error: root.status-is-error;
            groups: root.groups;
            show-create-wizard: root.show-create-wizard;
            create-wizard-step: root.create-wizard-step;
            create-wizard-error: root.create-wizard-error;
            create-wizard-summary: root.create-wizard-summary;
            group-name-input <=> root.group-name-input;
            threshold-input <=> root.threshold-input;
            signer-search <=> root.signer-search;
            signer-pick: root.signer-pick;
            group-detail-title: root.group-detail-title;
            group-detail-body: root.group-detail-body;
            group-ceremony-banner: root.group-ceremony-banner;
            show-forming-panel: root.show-forming-panel;
            forming-panel-hint: root.forming-panel-hint;
            forming-members: root.forming-members;
            show-accept-participation: root.show-accept-participation;
            start-dkg-enabled: root.start-dkg-enabled;
            show-membership-editor: root.show-membership-editor;
            member-remove-pick: root.member-remove-pick;
            member-add-pick: root.member-add-pick;
            group-signer-hint: root.group-signer-hint;
            show-group-sign-panel: root.show-group-sign-panel;
            group-sign-title: root.group-sign-title;
            group-sign-body: root.group-sign-body;
            group-sign-status: root.group-sign-status;
            group-sign-hint: root.group-sign-hint;
            group-sign-request-id: root.group-sign-request-id;
            group-sign-can-approve: root.group-sign-can-approve;
            show-solana-actions: root.show-solana-actions;
            solana-recipient <=> root.solana-recipient;
            solana-lamports <=> root.solana-lamports;
            inbox-tab-title: root.inbox-tab-title;
            requests: root.requests;
            refresh-clicked => { root.refresh-clicked(); }
            logout-clicked => { root.logout-clicked(); }
            create-group-clicked => { root.create-group-clicked(); }
            create-wizard-cancel => { root.create-wizard-cancel(); }
            create-wizard-back => { root.create-wizard-back(); }
            create-wizard-next => { root.create-wizard-next(); }
            create-wizard-create => { root.create-wizard-create(); }
            signer-search-changed(text) => { root.signer-search-changed(text); }
            toggle-signer(u) => { root.toggle-signer(u); }
            select-group(id) => { root.select-group(id); }
            start-dkg-clicked => { root.start-dkg-clicked(); }
            reshare-clicked => { root.reshare-clicked(); }
            request-solana-clicked => { root.request-solana-clicked(); }
            approve-request(id) => { root.approve-request(id); }
            reject-request(id) => { root.reject-request(id); }
            toggle-remove-member(u) => { root.toggle-remove-member(u); }
            toggle-add-member(u) => { root.toggle-add-member(u); }
            accept-participation-clicked => { root.accept-participation-clicked(); }
        }
    }
}
