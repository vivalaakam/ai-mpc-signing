{
  "comment": "Allowlist-inverted profile for Solana (Agave) test validator: it needs io_uring syscalls which the Docker default seccomp profile blocks. Default action is ALLOW, but a curated denylist blocks the common container-escape syscalls. Capabilities filtering continues to apply as configured by Docker.",
  "defaultAction": "SCMP_ACT_ALLOW",
  "architectures": ["SCMP_ARCH_X86_64", "SCMP_ARCH_X86", "SCMP_ARCH_X32"],
  "syscalls": [
    {
      "names": [
        "bpf",
        "perf_event_open",
        "kexec_load",
        "kexec_file_load",
        "reboot",
        "swapon",
        "swapoff",
        "init_module",
        "finit_module",
        "delete_module",
        "create_module",
        "query_module",
        "get_kernel_syms",
        "uselib",
        "open_by_handle_at",
        "name_to_handle_at",
        "fanotify_init",
        "fanotify_mark",
        "fsopen",
        "fsconfig",
        "fsmount",
        "fspick",
        "open_tree",
        "move_mount",
        "mount_setattr",
        "quotactl",
        "acct",
        "vhangup",
        "pivot_root",
        "lookup_dcookie",
        "nfsservctl",
        "_sysctl",
        "afs_syscall",
        "sysfs",
        "vm86",
        "vm86old",
        "iopl",
        "ioperm",
        "modify_ldt",
        "setns",
        "unshare",
        "ptrace",
        "process_vm_readv",
        "process_vm_writev",
        "kcmp",
        "add_key",
        "request_key",
        "keyctl"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    }
  ]
}
